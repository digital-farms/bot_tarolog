# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# ── LLM (OpenRouter) ─────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── TTS (OpenAI, опционально) ────────────────────────────
# Без этого ключа озвучка раскладов будет недоступна
OPENAI_TTS_API_KEY=sk-...

# ── Предзагрузка file_id (опционально) ───────────────────
# Chat ID для скрипта preload:tg (ваш личный Telegram ID)
PRELOAD_CHAT_ID=123456789

# ── Админ-панель ─────────────────────────────────────────
ADMIN_KEY=your-secret-password
ADMIN_PORT=3737
ADMIN_PATH=/tarot-panel-8x7k
